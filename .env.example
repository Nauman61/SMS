# Copy this file to ".env" and fill in your own Supabase project's values.
# Get these from your Supabase project dashboard → Settings → API.
#
# If you leave these blank / don't create a .env file, the app still works
# fine — it just falls back to storing data only in the local browser
# (see storageShim.js), which does not sync across devices.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
